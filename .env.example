# Copy to .env and fill locally. The phase-two agent loads this file automatically.
# The standalone phase-one importer still uses prompts or process environment variables.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Provider-neutral application settings; choose provider/model before implementation.
# These are our settings, not environment variables automatically read by LangChain.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
LLM_BASE_URL=

# For local inference: set LLM_PROVIDER=ollama and LLM_MODEL=qwen3:8b.
# No LLM_API_KEY is required for Ollama. Use a model supporting tool calls.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT_SECONDS=300
# Direct hosted inference: LLM_PROVIDER=ollama_cloud; choose a cloud model for LLM_MODEL.
# Get a key at https://ollama.com/settings/keys. Cloud uses https://ollama.com.
OLLAMA_API_KEY=

# Optional tracing. Enable after filling the key and selecting the correct region.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supply-chain-impact-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Proposed application defaults. Demo date matches the synthetic dataset.
AGENT_DEFAULT_DATE=2026-10-14
AGENT_MAX_TOOL_CALLS=12
NEO4J_QUERY_TIMEOUT_SECONDS=30
COMMUNITY_ANALYTICS_ENABLED=false
COMMUNITY_SESSION_TTL_MINUTES=10
