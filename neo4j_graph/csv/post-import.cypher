// Run after CSV import. Adds the shared label required by investigation queries.
MATCH (n:Category) WHERE n.id IN ["CAT-APP", "CAT-FOOT", "CAT-BAG"] SET n:Entity;
MATCH (n:Component) WHERE n.id IN ["C-CT", "C-TF", "C-RF", "C-RS", "C-FI", "C-MZ", "C-BK", "C-SC"] SET n:Entity;
MATCH (n:DC) WHERE n.id IN ["DC-E", "DC-C", "DC-S", "DC-W"] SET n:Entity;
MATCH (n:Disruption) WHERE n.id IN ["D-01", "D-02", "D-03", "D-04"] SET n:Entity;
MATCH (n:DistributionRoute) WHERE n.id IN ["DR-001", "DR-002", "DR-003", "DR-004", "DR-005", "DR-006", "DR-007", "DR-008", "DR-009", "DR-010", "DR-011", "DR-012", "DR-013", "DR-014", "DR-015", "DR-016", "DR-017", "DR-018", "DR-019", "DR-020", "DR-021", "DR-022", "DR-023", "DR-024", "DR-025", "DR-026", "DR-027", "DR-028", "DR-029", "DR-030", "DR-031", "DR-032", "DR-033", "DR-034", "DR-035", "DR-036", "DR-037", "DR-038", "DR-039", "DR-040", "DR-041", "DR-042", "DR-043", "DR-044", "DR-045", "DR-046", "DR-047", "DR-048", "DR-049", "DR-050", "DR-051", "DR-052", "DR-053", "DR-054", "DR-055", "DR-056", "DR-057", "DR-058", "DR-059", "DR-060", "DR-061", "DR-062", "DR-063", "DR-064", "DR-065", "DR-066", "DR-067", "DR-068", "DR-069", "DR-070", "DR-071", "DR-072", "DR-073", "DR-074", "DR-075", "DR-076", "DR-077", "DR-078", "DR-079", "DR-080", "DR-081", "DR-082", "DR-083", "DR-084", "DR-085", "DR-086"] SET n:Entity;
MATCH (n:Evidence) WHERE n.id IN ["E-MASTER", "E-SA-001", "E-SA-002", "E-SA-003", "E-SA-004", "E-SA-005", "E-SA-006", "E-SA-007", "E-SA-008", "E-SA-009", "E-SA-010", "E-SA-011", "E-SA-012", "E-SA-013", "E-SA-014", "E-SA-015", "E-SA-016", "E-SA-017", "E-SA-018", "E-SA-019", "E-SA-020", "E-SA-021", "E-SA-022", "E-SA-023", "E-SA-024", "E-SA-025", "E-SA-026", "E-SA-027", "E-SA-028", "E-SA-029", "E-SA-030", "E-SA-031", "E-SA-032", "E-SA-033", "E-SA-034", "E-SA-035", "E-SA-036", "E-SA-037", "E-SA-038", "E-SA-039", "E-SA-040", "E-SA-041", "E-SA-042", "E-SA-043", "E-SA-044", "E-SA-045", "E-SA-046", "E-SA-047", "E-SA-048", "E-SA-049", "E-SA-050", "E-SA-051", "E-SA-052", "E-SA-053", "E-SA-054", "E-SA-055", "E-SA-056", "E-SA-057", "E-SA-058", "E-SA-059", "E-SA-060", "E-SA-061", "E-SA-062", "E-SA-063", "E-SA-064", "E-SA-065", "E-SA-066", "E-SA-068", "E-SA-069", "E-SA-070", "E-DR-001", "E-DR-002", "E-DR-003", "E-DR-004", "E-DR-005", "E-DR-006", "E-DR-007", "E-DR-008", "E-DR-009", "E-DR-010", "E-DR-011", "E-DR-012", "E-DR-013", "E-DR-014", "E-DR-015", "E-DR-016", "E-DR-017", "E-DR-018", "E-DR-019", "E-DR-020", "E-DR-021", "E-DR-022", "E-DR-023", "E-DR-024", "E-DR-025", "E-DR-026", "E-DR-027", "E-DR-028", "E-DR-029", "E-DR-030", "E-DR-031", "E-DR-032", "E-DR-033", "E-DR-034", "E-DR-035", "E-DR-036", "E-DR-037", "E-DR-038", "E-DR-039", "E-DR-040", "E-DR-041", "E-DR-042", "E-DR-043", "E-DR-044", "E-DR-045", "E-DR-046", "E-DR-047", "E-DR-048", "E-DR-049", "E-DR-050", "E-DR-051", "E-DR-052", "E-DR-053", "E-DR-054", "E-DR-055", "E-DR-056", "E-DR-057", "E-DR-058", "E-DR-059", "E-DR-060", "E-DR-061", "E-DR-062", "E-DR-063", "E-DR-064", "E-DR-065", "E-DR-066", "E-DR-067", "E-DR-068", "E-DR-069", "E-DR-070", "E-DR-071", "E-DR-072", "E-DR-073", "E-DR-074", "E-DR-075", "E-DR-076", "E-DR-077", "E-DR-078", "E-DR-079", "E-DR-080", "E-DR-081", "E-DR-082", "E-DR-083", "E-DR-084", "E-DR-085", "E-DR-086", "E-D-01", "E-D-02", "E-D-03", "E-D-04"] SET n:Entity;
MATCH (n:ProductionFacility) WHERE n.id IN ["FAC-AE", "FAC-AW", "FAC-SN", "FAC-SS", "FAC-FP", "FAC-HP"] SET n:Entity;
MATCH (n:SKU) WHERE n.id IN ["A01", "A02", "A03", "A04", "F01", "F02", "F03", "F04", "B01", "B02", "B03", "B04"] SET n:Entity;
MATCH (n:SourcingArrangement) WHERE n.id IN ["SA-001", "SA-002", "SA-003", "SA-004", "SA-005", "SA-006", "SA-007", "SA-008", "SA-009", "SA-010", "SA-011", "SA-012", "SA-013", "SA-014", "SA-015", "SA-016", "SA-017", "SA-018", "SA-019", "SA-020", "SA-021", "SA-022", "SA-023", "SA-024", "SA-025", "SA-026", "SA-027", "SA-028", "SA-029", "SA-030", "SA-031", "SA-032", "SA-033", "SA-034", "SA-035", "SA-036", "SA-037", "SA-038", "SA-039", "SA-040", "SA-041", "SA-042", "SA-043", "SA-044", "SA-045", "SA-046", "SA-047", "SA-048", "SA-049", "SA-050", "SA-051", "SA-052", "SA-053", "SA-054", "SA-055", "SA-056", "SA-057", "SA-058", "SA-059", "SA-060", "SA-061", "SA-062", "SA-063", "SA-064", "SA-065", "SA-066", "SA-067", "SA-068", "SA-069", "SA-070"] SET n:Entity;
MATCH (n:Store) WHERE n.id IN ["ST-BOS", "ST-NYC", "ST-CHI", "ST-MIN", "ST-DAL", "ST-ATL", "ST-SEA", "ST-LA"] SET n:Entity;
MATCH (n:Supplier) WHERE n.id IN ["SUP-AP", "SUP-SM", "SUP-FC", "SUP-HP"] SET n:Entity;
MATCH (n:Vendor) WHERE n.id IN ["V-NA", "V-TW", "V-UC", "V-EE"] SET n:Entity;
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
MATCH (n:Entity) RETURN count(n) AS nodes;
MATCH (:Entity)-[r]->(:Entity) RETURN count(r) AS relationships;
